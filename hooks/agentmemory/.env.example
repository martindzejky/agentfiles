# Copy this file to .env, set its permissions to 600, and fill in the secret.
AGENTMEMORY_URL=https://memory.martinjakubik.com
AGENTMEMORY_SECRET=
AGENTMEMORY_REQUIRE_HTTPS=1
AGENTMEMORY_INJECT_CONTEXT=true

# Optional override when the Git repository basename is not the desired name.
# AGENTMEMORY_PROJECT_NAME=
