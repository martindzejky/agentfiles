{
  "description": "AgentMemory observation capture",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/agentmemory/codex/user-prompt-submit.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/agentmemory/codex/stop.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/agentmemory/codex/post-tool-use.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/agentmemory/codex/subagent-start.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/agentmemory/codex/subagent-stop.mjs",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
